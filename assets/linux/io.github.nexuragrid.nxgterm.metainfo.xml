  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>nxgterm</name>
  <summary>Fast, configurable, cross-platform terminal emulator</summary>
  <description>
    <p>
      nxgterm is a terminal emulator written in Rust. It renders text on the GPU
      and falls back to a CPU renderer automatically, so it always starts.
    </p>
    <ul>
      <li>TOML configuration with live reload, built-in themes and font settings</li>
      <li>Inline images through the Kitty graphics protocol and Sixel</li>
      <li>Runs on Linux, macOS and Windows</li>
    </ul>
  </description>
  <launchable type="desktop-id">nxgterm.desktop</launchable>
  <icon type="stock">nxgterm</icon>
  <categories>
    <category>System</category>
    <category>TerminalEmulator</category>
  </categories>
